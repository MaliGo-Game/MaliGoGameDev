# Images
# NOTE: kept off Git LFS (regular git blobs instead) because this project's
# GitHub account LFS storage/bandwidth budget is exhausted and images are
# this 2D game's primary asset type. Revisit if the LFS budget is increased.
*.bmp                   binary
*.exr                   binary
*.gif                   binary
*.hdr                   binary
*.iff                   binary
*.jpeg                  binary
*.jpg                   binary
*.pict                  binary
*.png                   binary
*.psd                   binary
*.tga                   binary
*.tif                   binary
*.tiff                  binary
*.webp                  binary
# Compressed Archive
*.7z                    lfs
*.bz2                   lfs
*.gz                    lfs
*.rar                   lfs
*.tar                   lfs
*.zip                   lfs
# Compiled Dynamic Library
*.dll                   lfs
*.pdb                   lfs
*.so                    lfs
# Fonts
# Executable/Installer
*.apk                   lfs
*.exe                   lfs
# Documents
*.pdf                   lfs
# ETC
*.a                     lfs
*.reason                lfs
*.rns                   lfs
# Spine export file for Unity
*.skel.bytes            lfs
# Exceptions for .asset files such as lightning pre-baking
LightingData.asset     binary
# Third-party Kenney asset packs: store as regular git blobs, not LFS
# (free downloadable art, keeps them off the Git LFS storage/bandwidth budget)
Assets/kenney_*/** -filter -diff -merge -text
Assets/kenney_*/** !text !filter !merge !diff
*.png !text !filter !merge !diff
# Research papers: regular git blobs too, same reason (LFS storage/bandwidth budget
# exhausted on this account - see the *.png note above, same constraint applies here).
*.pdf !text !filter !merge !diff
# Fonts and audio: regular git blobs too, same reason (LFS storage/bandwidth budget
# exhausted on this account - see the *.png note above, same constraint applies here).
*.ttf !text !filter !merge !diff
*.otf !text !filter !merge !diff
*.ogg !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
